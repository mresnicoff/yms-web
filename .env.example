# URL base de la API del backend (yms-back), incluyendo el prefijo /api.
# En desarrollo local (con el backend corriendo con `npm run dev`):
# VITE_API_URL=http://localhost:3000/api
#
# En producción (Vercel), poné la URL del backend ya desplegado, por ejemplo:
# VITE_API_URL=https://yms-back.vercel.app/api
VITE_API_URL=http://localhost:3000/api
